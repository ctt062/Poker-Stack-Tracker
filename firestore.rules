rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isHost() {
      return isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    function isParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.participants;
    }

    function myRole() {
      return resource.data.participants[request.auth.uid].role;
    }

    function canEditGame() {
      return isParticipant() && myRole() in ['host', 'editor'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyMyParticipantChanged() {
      return request.resource.data.participants
        .diff(resource.data.participants)
        .affectedKeys()
        .hasOnly([request.auth.uid]);
    }

    // Stable shared fields for non-host writers. Prefer "not touched" over
    // map equality so missing optional fields (e.g. bans) never break joins.
    function coreFieldsStable() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.code == resource.data.code
        && request.resource.data.status == resource.data.status
        && request.resource.data.game == resource.data.game
        && !changedKeys().hasAny(['bans', 'emptyAt']);
    }

    // Kick ban stored as bans.{uid}.until (epoch ms). Expired bans are ignored.
    function isActivelyBanned() {
      return 'bans' in resource.data
        && request.auth.uid in resource.data.bans
        && resource.data.bans[request.auth.uid].keys().hasAll(['until'])
        && resource.data.bans[request.auth.uid].until is number
        && resource.data.bans[request.auth.uid].until > request.time.toMillis();
    }

    function isAbandonedPastTtl() {
      return resource.data.status == 'abandoned'
        && 'emptyAt' in resource.data
        && resource.data.emptyAt is number
        && request.time.toMillis() > resource.data.emptyAt + 600000;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    // True when the referenced room is missing (already deleted, or created in
    // the same batch as its code) or when the caller is its host.
    function ownsRoomOrRoomMissing(roomId) {
      return !exists(roomPath(roomId))
        || get(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    // Anyone signed in may delete a room code when the room is gone, abandoned,
    // or they are still the host (end room / last leave).
    function canDeleteRoomCode() {
      return isSignedIn() && (
        !exists(roomPath(resource.data.roomId))
        || get(roomPath(resource.data.roomId)).data.hostId == request.auth.uid
        || get(roomPath(resource.data.roomId)).data.status in ['ended', 'abandoned']
      );
    }

    // Short code -> roomId (code secrecy is the main join gate, so codes and
    // rooms must never be enumerable: single-document gets only).
    match /roomCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['roomId', 'createdAt'])
        && request.resource.data.roomId is string
        && ownsRoomOrRoomMissing(request.resource.data.roomId);
      allow delete: if canDeleteRoomCode();
      allow update: if false;
    }

    // Globally unique display names. Doc id is the lowercase trimmed name.
    match /displayNames/{nameKey} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'nameKey'])
        && request.resource.data.nameKey == nameKey
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && nameKey == request.resource.data.displayName.trim().lower();
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nameKey == nameKey
        && nameKey == request.resource.data.displayName.trim().lower();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants[request.auth.uid].role == 'host'
        && request.resource.data.status == 'active';

      allow update: if isSignedIn() && (
        // Host: full control (roles, kick, transfer, abandon, game, etc.)
        isHost()
        // Editor: game state only while live
        || (
          canEditGame()
          && changedKeys().hasOnly(['game', 'updatedAt'])
          && resource.data.status == 'active'
        )
        // Existing participant: presence / rename self only
        || (
          isParticipant()
          && resource.data.status == 'active'
          && changedKeys().hasOnly(['participants', 'updatedAt'])
          && onlyMyParticipantChanged()
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants[request.auth.uid].role
            == resource.data.participants[request.auth.uid].role
          && coreFieldsStable()
        )
        // Leaving: remove yourself only (others remain)
        || (
          isParticipant()
          && changedKeys().hasOnly(['participants', 'updatedAt'])
          && onlyMyParticipantChanged()
          && !(request.auth.uid in request.resource.data.participants)
          && coreFieldsStable()
        )
        // Last person leaving: mark abandoned so the room can be purged later
        || (
          isParticipant()
          && resource.data.status == 'active'
          && resource.data.participants.keys().hasOnly([request.auth.uid])
          && request.resource.data.status == 'abandoned'
          && request.resource.data.participants.keys().size() == 0
          && 'emptyAt' in request.resource.data
          && request.resource.data.emptyAt is number
          && request.resource.data.code == resource.data.code
          && request.resource.data.game == resource.data.game
        )
        // First join / re-join as viewer while room is live and not banned
        || (
          !(request.auth.uid in resource.data.participants)
          && resource.data.status == 'active'
          && !isActivelyBanned()
          && changedKeys().hasOnly(['participants', 'updatedAt'])
          && onlyMyParticipantChanged()
          && coreFieldsStable()
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants[request.auth.uid].role == 'viewer'
        )
      );

      // Host can delete anytime; anyone can purge abandoned rooms after 10 minutes
      allow delete: if isHost() || isAbandonedPastTtl();
    }
  }
}
